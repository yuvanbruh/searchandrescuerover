<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="sar_building_v2">
    <!-- DARK / FOG SHOWCASE VERSION of sar_building_v2 (demo recordings only).
         Same as the dark/fog showcase world EXCEPT: all dead trees removed and all point/spot
         lights removed (no light gizmos); only the sun remains. Sensor plugins are identical to the
         original sar_building_v2.sdf. The particle-emitter plugin is the only extra plugin and is only
         needed for the 'smoke' model. Walls, collisions, victims and clutter are identical to the original.
         Added props have NO collision, but a gpu_lidar ray-casts rendered geometry, so test SLAM;
         delete the 'debris', 'smoke', 'fog_layers' models if the map gets polluted. -->

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics"
            filename="gz-sim-physics-system"/>

    <plugin name="gz::sim::systems::UserCommands"
            filename="gz-sim-user-commands-system"/>

    <plugin name="gz::sim::systems::SceneBroadcaster"
            filename="gz-sim-scene-broadcaster-system"/>

    <plugin name="gz::sim::systems::Contact"
            filename="gz-sim-contact-system"/>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- only needed for the smoke emitters -->
    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.17 0.19 0.19 1</ambient>
      <background>0.13 0.15 0.15 1</background>
      <shadows>true</shadows>
      <fog>
        <color>0.16 0.18 0.18 1</color>
        <type>exp2</type>
        <density>0.03</density>
      </fog>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
          <material><ambient>0.04 0.05 0.05 1</ambient><diffuse>0.07 0.08 0.08 1</diffuse><specular>0.10 0.10 0.10 1</specular><pbr><metal><roughness>0.35</roughness><metalness>0.0</metalness></metal></pbr></material>
        </visual>
        <pose>12 6 0 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz></inertia>
        </inertial>
      </link>
      <self_collide>false</self_collide>
    </model>

    <light name="sun" type="directional">
      <pose>12 6 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>0.32</intensity>
      <direction>-0.4 0.2 -0.9</direction>
      <diffuse>0.55 0.62 0.60 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>1000</range><linear>0.01</linear><constant>0.9</constant><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0</inner_angle><outer_angle>0</outer_angle><falloff>0</falloff></spot>
    </light>

    <model name="floor_zones">
      <static>true</static>
      <link name="floor_corridor"><pose>12 6 0.01 0 0 0</pose>
        <visual name="v"><geometry><box><size>24 2.4 0.02</size></box></geometry>
          <material><ambient>0.07 0.08 0.08 1</ambient><diffuse>0.11 0.12 0.12 1</diffuse><specular>0.15 0.15 0.15 1</specular><pbr><metal><roughness>0.25</roughness><metalness>0.0</metalness></metal></pbr></material></visual></link>
