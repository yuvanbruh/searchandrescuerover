<sdf version='1.10'>
  <world name='yolo_test_arena'>
    <physics name='1ms' type='bullet-featherstone'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>
    <atmosphere type='adiabatic'/>

    <!-- Bright, even, shadowless lighting on purpose -->
    <!-- YOLO struggles with harsh shadows/low light; we want to rule that OUT as a variable first -->
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.8 0.8 0.85 1</background>
      <shadows>false</shadows>
    </scene>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.3 0.1 -0.9</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <light name="fill_light" type="point">
      <pose>0 0 4 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>600</intensity>
      <attenuation><range>20</range><constant>0.7</constant><linear>0.03</linear><quadratic>0.002</quadratic></attenuation>
    </light>

    <!-- Plain flat floor, neutral gray, non-reflective, non-distracting -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 20 0.2</size></box></geometry>
          <pose>0 0 -0.1 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 20 0.2</size></box></geometry>
          <pose>0 0 -0.1 0 0 0</pose>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- REAL, TEXTURED, RECOGNIZABLE OBJECTS FROM FUEL  -->
    <!-- These have actual COCO-relevant shapes/textures -->
    <!-- Placed at 2-4m from world origin (assumed spawn) -->
    <!-- One object at a time, spaced far apart, so a     -->
    <!-- missed detection can't be blamed on clutter      -->
    <!-- ============================================== -->

    <!-- Backpack: real COCO class "backpack" -->
    <model name="target_backpack">
      <pose>3 0 0 0 0 0</pose>
      <static>true</static>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/JanSport Backpack Red</uri>
      </include>
    </model>

    <!-- Person-shaped mannequin: real COCO class "person" -->
    <model name="target_person">
      <pose>0 3 0 0 0 0</pose>
      <static>true</static>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Rescue Randy Sitting</uri>
      </include>
    </model>

    <!-- Phone-shaped object: real COCO class "cell phone" -->
    <model name="target_phone">
      <pose>-3 0 0.8 0 0 0</pose>
      <static>true</static>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Samsung J8 Black</uri>
      </include>
    </model>

    <!-- Fire extinguisher: not a COCO class, but a real SubT artifact -->
    <!-- Useful to test "does it correctly detect NOTHING/no confident box" -->
    <!-- rather than hallucinating a COCO class onto it -->
    <model name="target_extinguisher">
      <pose>0 -3 0 0 0 0</pose>
      <static>true</static>
      <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Extinguisher</uri>
      </include>
    </model>

  </world>
</sdf>