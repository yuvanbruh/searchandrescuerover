<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="sar_building_v2">

    <!-- ====================================================================
         SAR SUBTERRANEAN/BUILDING WORLD - v2
         Base layout unchanged from v1: west entrance -> east-west corridor
         (spine) -> 6 rooms (3 south, 3 north), separated by room-dividing
         walls. Room footprints and the one deliberate pinch doorway are
         UNCHANGED from v1 so any prior validation of that structural test
         point still holds.

         WHAT'S NEW IN v2 (added to create genuine exploration-policy
         decision ambiguity, per Mission 2 hand-designed-vs-RL comparison
         needs, since a single spine+branches layout gives near-zero choice
         at any decision point, which can't differentiate policies):

         1. TWO LOOP DOORWAYS (secondary difficulty tier, 1.6m clear,
            between the pinch-door 1.3m and normal-door 1.8m):
              - South room 2 <-> South room 3 (via divider at x=16)
              - North room 1 <-> North room 2 (via divider at x=8)
            These create real branching: a room can now be reached via
            two different corridor entry points, so the exploration
            policy has to choose between paths with different
            info-gain/travel-cost tradeoffs, and a "have I already
            explored this via the other door" question the original
            single-spine layout never posed.

         2. CLUTTER / OCCLUSION boxes in 5 of 6 rooms (South 1, South 2,
            South 3, North 1, North 2), placed so the victim is NOT
            immediately visible from every entrance. North room 3 is
            deliberately left clear as an easy/control case, keeping at
            least one trivial room so you can distinguish "policy failed"
            from "task was hard everywhere."

         3. Victim positions in South room 2 and North room 2 nudged to
            sit near/behind their clutter box rather than dead-center in
            the room, so detection difficulty depends on which doorway
            the robot approaches from (tests path-dependent detection,
            not just path-dependent travel cost).

         NOT changed / deliberately deferred:
         - Room footprints and depths are still uniform (8m x 4.8m per
           room) as in v1. Making some rooms bigger/farther (for a
           genuine high-info-gain-but-high-cost room) requires a jagged
           exterior perimeter with per-room wall segments; that's a good
           next revision but higher risk of an authored collision gap,
           so it's deliberately left for a v3 rather than guessed at here.
         - No uneven terrain: orthogonal to the EXPLORE/INVESTIGATE
           decision policy this world is meant to stress-test.

         Corridor clear width : 2.4 m
         Normal doorways      : 1.8 m clear (x=4, x=12, x=20 both walls)
         Loop doorways (NEW)  : 1.6 m clear (South x=16 divider,
                                 North x=8 divider)
         Pinch doorway         : 1.3 m clear (South room 2 <-> corridor,
                                 UNCHANGED from v1 - single deliberate
                                 collapsed-passage test point)

         RECOMMENDED SPAWN: x=0.5, y=6.0, yaw=0

         Building bounding box: x:[0,24]  y:[0,12]  (unchanged from v1)
         Corridor centerline  : y=6.0 (walls at y=4.8 and y=7.2)
         Room dividers        : x=8, x=16
         ==================================================================== -->

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics"
            filename="gz-sim-physics-system"/>

    <plugin name="gz::sim::systems::UserCommands"
            filename="gz-sim-user-commands-system"/>

    <plugin name="gz::sim::systems::SceneBroadcaster"
            filename="gz-sim-scene-broadcaster-system"/>

    <plugin name="gz::sim::systems::Contact"
            filename="gz-sim-contact-system"/>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
        <pose>12 6 0 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz></inertia>
        </inertial>
      </link>
      <self_collide>false</self_collide>
    </model>

    <light name="sun" type="directional">
      <pose>12 6 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><linear>0.01</linear><constant>0.9</constant><quadratic>0.001</quadratic></attenuation>
      <spot><inner_angle>0</inner_angle><outer_angle>0</outer_angle><falloff>0</falloff></spot>
    </light>

    <!-- ==================== STRUCTURE (primitive boxes = guaranteed-correct collision) ==================== -->
    <model name="sar_building_structure">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- Corridor south wall (y=4.8), 3 gaps: doors at x=4 (1.8m), x=12 (1.3m PINCH), x=20 (1.8m) -->
      <link name="wall_corr_south_A">
        <pose>1.55 4.8 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.1 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.1 0.15 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
      <link name="wall_corr_south_B">
        <pose>8.125 4.8 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.45 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.45 0.15 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
      <link name="wall_corr_south_C">
        <pose>15.875 4.8 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.45 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.45 0.15 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
      <link name="wall_corr_south_D">
        <pose>22.45 4.8 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.1 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.1 0.15 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>

      <!-- Corridor north wall (y=7.2), 3 gaps all 1.8m: doors at x=4, x=12, x=20 -->
      <link name="wall_corr_north_E">
        <pose>1.55 7.2 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.1 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.1 0.15 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
      <link name="wall_corr_north_F">
        <pose>8.0 7.2 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.2 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.2 0.15 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
      <link name="wall_corr_north_G">
        <pose>16.0 7.2 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.2 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.2 0.15 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
      <link name="wall_corr_north_H">
        <pose>22.45 7.2 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.1 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.1 0.15 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>

      <!-- ============ South room dividers ============ -->
      <!-- x=8 divider (South room1 <-> South room2): UNCHANGED solid wall, no loop door here -->
      <link name="wall_div_south_I">
        <pose>8 2.4 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 4.8 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 4.8 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>

      <!-- x=16 divider (South room2 <-> South room3): NEW 1.6m LOOP DOORWAY
           split into two segments, gap at y:[1.6,3.2] -->
      <link name="wall_div_south_J1">
        <pose>16 0.8 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 1.6 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.6 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
      <link name="wall_div_south_J2">
        <pose>16 4.0 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 1.6 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.6 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>

      <!-- ============ North room dividers ============ -->
      <!-- x=8 divider (North room1 <-> North room2): NEW 1.6m LOOP DOORWAY
           split into two segments, gap at y:[8.8,10.4] -->
      <link name="wall_div_north_K1">
        <pose>8 8.0 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 1.6 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.6 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
      <link name="wall_div_north_K2">
        <pose>8 11.2 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 1.6 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.6 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>

      <!-- x=16 divider (North room2 <-> North room3): UNCHANGED solid wall, no loop door here -->
      <link name="wall_div_north_L">
        <pose>16 9.6 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 4.8 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 4.8 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>

      <!-- Exterior perimeter -->
      <link name="wall_ext_south_M">
        <pose>12 0 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>24 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>24 0.15 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
      <link name="wall_ext_north_N">
        <pose>12 12 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>24 0.15 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>24 0.15 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>

      <!-- West wall with entrance gap at y:[4.8,7.2] (2.4m opening, matches corridor) -->
      <link name="wall_ext_west_sub1">
        <pose>0 2.4 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 4.8 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 4.8 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
      <link name="wall_ext_west_sub2">
        <pose>0 9.6 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 4.8 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 4.8 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>

      <!-- East wall, closed (dead end) -->
      <link name="wall_ext_east_O">
        <pose>24 6 1.1 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 12 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 12 2.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>

      <!-- ==================== CLUTTER (occlusion test boxes, NEW in v2) ====================
           Small crates (0.6 x 0.6 x 0.9 m) placed to break direct line-of-sight
           from a room's most obvious entrance to its victim. Purely visual
           obstacles for the detection pipeline; collision included since
           they should also be legitimate costmap obstacles, not phantom-only. -->

      <!-- South room 1: blocks view from the x=4 corridor doorway toward victim_1 -->
      <link name="clutter_south1_a">
        <pose>3.4 3.3 0.45 0 0 0.3</pose>
        <collision name="c"><geometry><box><size>0.6 0.6 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.9</size></box></geometry>
          <material><ambient>0.45 0.35 0.25 1</ambient><diffuse>0.45 0.35 0.25 1</diffuse></material></visual>
      </link>

      <!-- South room 2 (behind the pinch): blocks view from the pinch doorway (x=12)
           toward victim_2, but victim_2 sits closer to the NEW loop doorway (x=16)
           side, so approach angle changes detection difficulty -->
      <link name="clutter_south2_a">
        <pose>13.6 3.6 0.45 0 0 -0.5</pose>
        <collision name="c"><geometry><box><size>0.6 0.6 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.9</size></box></geometry>
          <material><ambient>0.45 0.35 0.25 1</ambient><diffuse>0.45 0.35 0.25 1</diffuse></material></visual>
      </link>

      <!-- South room 3: blocks view from the x=20 corridor doorway; victim_3 easier
           to see from the NEW loop doorway (x=16) side instead -->
      <link name="clutter_south3_a">
        <pose>19.2 2.9 0.45 0 0 0.9</pose>
        <collision name="c"><geometry><box><size>0.6 0.6 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.9</size></box></geometry>
          <material><ambient>0.45 0.35 0.25 1</ambient><diffuse>0.45 0.35 0.25 1</diffuse></material></visual>
      </link>

      <!-- North room 1: blocks view from x=4 corridor doorway; easier from
           the NEW loop doorway (x=8) side -->
      <link name="clutter_north1_a">
        <pose>5.1 8.6 0.45 0 0 -0.2</pose>
        <collision name="c"><geometry><box><size>0.6 0.6 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.9</size></box></geometry>
          <material><ambient>0.45 0.35 0.25 1</ambient><diffuse>0.45 0.35 0.25 1</diffuse></material></visual>
      </link>

      <!-- North room 2: blocks view from x=12 corridor doorway; victim_5 sits
           closer to the NEW loop doorway (x=8) side instead -->
      <link name="clutter_north2_a">
        <pose>12.2 8.9 0.45 0 0 0.6</pose>
        <collision name="c"><geometry><box><size>0.6 0.6 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.9</size></box></geometry>
          <material><ambient>0.45 0.35 0.25 1</ambient><diffuse>0.45 0.35 0.25 1</diffuse></material></visual>
      </link>

      <!-- North room 3: DELIBERATELY left clear (no clutter), control/easy case -->

    </model>

    <!-- ==================== VICTIMS (real Fuel models, same ones already confirmed working) ==================== -->

    <!-- South room 1 (x:0-8, y:0-4.8) -->
    <include>
      <name>victim_1</name>
      <pose>3.0 2.0 0 0 0 1.2</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/rescue randy</uri>
    </include>

    <!-- South room 2 (x:8-16, y:0-4.8) - behind the pinch doorway.
         Position nudged near the new x=16 loop doorway relative to v1,
         so it's the far corner from the pinch entrance -->
    <include>
      <name>victim_2</name>
      <pose>14.5 2.6 0 0 0 -0.8</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Rescue Randy Sitting</uri>
    </include>

    <!-- South room 3 (x:16-24, y:0-4.8) -->
    <include>
      <name>victim_3</name>
      <pose>20.5 2.0 0 0 0 2.4</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/walking person</uri>
    </include>

    <!-- North room 1 (x:0-8, y:7.2-12) -->
    <include>
      <name>victim_4</name>
      <pose>4.0 9.5 0 0 0 0.4</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/rescue randy</uri>
    </include>

    <!-- North room 2 (x:8-16, y:7.2-12) - position nudged near the new
         x=8 loop doorway relative to v1 -->
    <include>
      <name>victim_5</name>
      <pose>10.2 9.6 0 0 0 -1.6</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Rescue Randy Sitting</uri>
    </include>

    <!-- North room 3 (x:16-24, y:7.2-12) - control/easy case, no clutter in room -->
    <include>
      <name>victim_6</name>
      <pose>19.5 9.8 0 0 0 3.0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/walking person</uri>
    </include>

  </world>
</sdf>